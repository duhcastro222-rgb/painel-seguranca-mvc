# Copie este arquivo para .env e preencha com os seus valores.
# O .env está no .gitignore e nunca vai para o repositório.

# MySQL (ativos)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=seu_usuario
DB_PASSWORD=sua_senha
DB_NAME=painel_seguranca

# MongoDB (vulnerabilidades)
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=painel_seguranca
MONGO_COLLECTION=vulnerabilidades

# Servidor Flask
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=0

# Validade do cache de reputação de IPs (horas)
CACHE_IPS_HORAS=24
